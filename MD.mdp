; Production MD (no restraints)
define                 =
integrator             = md
nsteps                 = 100000000    ; 2 fs x 1e8 = 200 ns
dt                     = 0.002
nstxout-compressed     = 5000
nstenergy              = 5000
nstlog                 = 5000
continuation           = yes
constraint-algorithm   = lincs
constraints            = h-bonds
lincs-iter             = 1
lincs-order            = 4
cutoff-scheme          = Verlet
nstlist                = 20
coulombtype            = PME
rcoulomb               = 1.2
pme-order              = 4
fourierspacing         = 0.16
vdwtype                = cutoff
vdw-modifier           = force-switch
rvdw-switch            = 1.0
rvdw                   = 1.2
DispCorr               = no
tcoupl                 = V-rescale
tc-grps                = Protein_LIG Water_and_ions
tau-t                  = 0.1 0.1
ref-t                  = 300 300
pcoupl                 = C-rescale
pcoupltype             = isotropic
tau-p                  = 2.0
ref-p                  = 1.0
compressibility        = 4.5e-5
refcoord-scaling       = com
pbc                    = xyz
gen-vel                = no
