; NVT equilibration, protein-ligand complex (restrained)
define                 = -DPOSRES
integrator             = md
nsteps                 = 50000        ; 2 fs x 50000 = 100 ps
dt                     = 0.002
nstxout-compressed     = 5000
nstenergy              = 500
nstlog                 = 500
continuation           = no
constraint-algorithm   = lincs
constraints            = h-bonds
lincs-iter             = 1
lincs-order            = 4
cutoff-scheme          = Verlet
nstlist                = 20
coulombtype            = PME
rcoulomb               = 1.2
pme-order              = 4
fourierspacing         = 0.16
vdwtype                = cutoff
vdw-modifier           = force-switch
rvdw-switch            = 1.0
rvdw                   = 1.2
DispCorr               = no
tcoupl                 = V-rescale
tc-grps                = Protein_LIG Water_and_ions
tau-t                  = 0.1 0.1
ref-t                  = 300 300
pcoupl                 = no
pbc                    = xyz
gen-vel                = yes
gen-temp               = 300
gen-seed               = -1
